<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="Threadly" android:icon="@mipmap/ic_launcher" android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false" android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- Sentry crash reporting: manifest auto-init; empty DSN disables the SDK, so only release builds report. send-default-pii stays off. -->
        <meta-data android:name="io.sentry.dsn" android:value="${sentryDsn}" />
        <meta-data android:name="io.sentry.send-default-pii" android:value="false" />
        <!-- No user-interaction breadcrumbs: Compose semantics labels (e.g. guess field) must not leave the device. -->
        <meta-data android:name="io.sentry.breadcrumbs.user-interaction" android:value="false" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
